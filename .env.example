# Token do bot (NUNCA compartilhar)
TOKEN=SEU_TOKEN_AQUI

# Credenciais do MongoDB
MONGODB_URI=mongodb://localhost:27017/tropa_barbie

# ID do servidor principal (Guild)
GUILD_ID=ID_DO_SERVIDOR

# Client ID do bot
CLIENT_ID=ID_DO_CLIENTE

# Prefixo para logs
LOG_PREFIX=TropaDaBarbie
